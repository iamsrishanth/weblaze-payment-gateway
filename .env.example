# Copy to .env.local for local work or configure each value in your host's private settings.
# All values below are synthetic examples. Replace them before using this installation.
NODE_ENV=development
MERCHANT_DISPLAY_NAME=Example Workshop
GATEWAY_PUBLIC_ORIGIN=https://gateway.example.test
UPI_PAYEE_VPA=example.workshop@upi
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weblaze_gateway
# Only use true in Docker Compose, where the database is the private db service.
# Keep false for Vercel or another host that needs a public database endpoint.
ALLOW_PRIVATE_DATABASE_HOST=false
POSTGRES_USER=weblaze_gateway
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=weblaze_gateway

# Generate each secret separately with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MERCHANT_API_KEY=replace-with-a-random-32-byte-value
SESSION_SECRET=replace-with-a-different-random-32-byte-value
ORDER_TOKEN_SECRET=replace-with-another-random-32-byte-value

# Used only by the one-time administrator bootstrap command. Remove after initialization.
BOOTSTRAP_ADMIN_EMAIL=operator@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
